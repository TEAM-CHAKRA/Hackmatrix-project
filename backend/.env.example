# CYBERLENS backend configuration — copy to backend/.env and fill in.
# Never commit .env. Every variable below is read by src/config/env.js.

# --- Server ------------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Exact frontend origin(s), comma-separated. Used for CORS and the CSRF origin check.
FRONTEND_URL=http://localhost:5173
# Behind a reverse proxy / load balancer (e.g. 1 = one hop). Leave empty locally.
TRUST_PROXY=
JSON_BODY_LIMIT=100kb

# --- Sessions (Phase 1) ---------------------------------------------------------
# Required in production (>= 32 random chars). Leave empty in development for a
# random per-process secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_COOKIE_NAME=cyberlens.sid
SESSION_MAX_AGE=28800
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_DOMAIN=
# Only used with the in-memory database: production requires this to be
# explicitly true for a single-instance deployment. Not needed with Supabase.
ALLOW_MEMORY_SESSION_STORE=

# --- Database: Supabase (see docs/DATABASE.md) -----------------------------------
# Leave both empty to use the in-memory database (data resets on restart).
# Backend only: use the SECRET key (service_role / sb_secret_…), never the anon key,
# and never put it in the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional override: memory | supabase (empty = automatic)
DB_PROVIDER=

# --- Password hashing (Argon2id) ----------------------------------------------
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Auth rate limits (per client IP) ------------------------------------------
AUTH_RATE_LIMIT_WINDOW=900
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_REGISTER_MAX_ATTEMPTS=5

# --- Optional admin account (created at startup; needed to moderate community reports)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=CYBERLENS Admin

# --- Threat intelligence (optional; checks report "unavailable" without them) ----
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_API_KEY=
CERTSPOTTER_API_KEY=

# --- AI narrative (optional; template explanations are used without it) ---------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Blockchain (Phase 8) -------------------------------------------------------
# local   = Hardhat node on your machine (cd contracts && npm run node)
# sepolia = Ethereum Sepolia testnet (throwaway wallet only!)
CHAIN_MODE=local
LOCAL_RPC_URL=http://127.0.0.1:8545
SEPOLIA_RPC_URL=
# Printed by `npm run deploy:local` / `npm run deploy:sepolia` in contracts/
REGISTRY_CONTRACT_ADDRESS=
# Local: the "Account #0" private key printed by `npm run node` (public test key).
# Sepolia: the private key of a THROWAWAY wallet funded with test ETH.
REGISTRY_SIGNER_PRIVATE_KEY=
CHAIN_TX_TIMEOUT_MS=75000
