# CYBERLENS frontend environment.
# Copy to .env.local (never commit real .env files).
# Only VITE_* variables reach the browser — NEVER put API keys or private keys here.

# Base path for API calls. Leave as /api in dev (Vite proxies it to the backend).
# In production, set to the deployed backend, e.g. https://api.cyberlens.example/api
VITE_API_BASE_URL=/api

# Where the Vite dev server proxies /api to (dev only).
VITE_BACKEND_PROXY_TARGET=http://localhost:4000

# true = use clearly labelled DEMO FIXTURES instead of the backend.
# Demo mode never creates blockchain transactions and never shows real threat intel.
VITE_USE_MOCKS=false
